package pages

import (
	"github.com/Constellation-Overwatch/constellation-overwatch/pkg/services/web/features/common/components"
	"github.com/Constellation-Overwatch/constellation-overwatch/pkg/services/web/features/common/layouts"
	"github.com/Constellation-Overwatch/constellation-overwatch/pkg/shared"
)

templ VideoPage(entityIDs []string, mtxConfig components.MediaMTXConfig) {
	@layouts.Base("Video") {
		@components.Navigation("video") {
			<div class="tab-content">
				@VideoPanel(entityIDs, mtxConfig)
			</div>
			@VideoPageStyles(mtxConfig)
		}
	}
}

templ VideoPanel(entityIDs []string, mtxConfig components.MediaMTXConfig) {
	<div id="video-panel"
		class="panel"
		data-signals="{
			activeStreams: [],
			streamCount: 0,
			onlineCount: 0,
			offlineCount: 0,
			mediamtxOnline: false,
			lastUpdate: '',
			_isConnected: false,
			selectedEntity: ''
		}"
		data-init="@get('/api/video/list')">
		<div class="panel-header">
			<h2>Video Feeds (WebRTC)</h2>
			<div class="status-bar">
				<span class="connection-status" data-show="$_isConnected">
					<span class="status-dot connected"></span>
					SSE Connected
				</span>
				<span class="connection-status" data-show="!$_isConnected">
					<span class="status-dot disconnected"></span>
					Connecting...
				</span>
				<span class="mediamtx-status" data-show="$_isConnected && $mediamtxOnline" style="margin-left: 10px;">
					<span class="status-dot connected" style="background: #0f8;"></span>
					<span style="color: #0f8; font-size: 12px;">MediaMTX Online</span>
				</span>
				<span class="mediamtx-status" data-show="$_isConnected && !$mediamtxOnline" style="margin-left: 10px;">
					<span class="status-dot disconnected" style="background: #f55;"></span>
					<span style="color: #f55; font-size: 12px;">MediaMTX Offline</span>
				</span>
				<span class="stats" data-show="$_isConnected && $streamCount > 0" style="margin-left: 15px; color: #0ff; font-size: 0.9em;">
					<span data-text="$onlineCount + ' live'"></span>
					<span data-show="$offlineCount > 0" data-text="' / ' + $offlineCount + ' offline'" style="color: #888;"></span>
				</span>
				<span class="last-update" data-show="$lastUpdate != ''" data-text="'Updated: ' + $lastUpdate"></span>
			</div>
		</div>
		<div class="video-controls-bar" style="padding: 15px; border-bottom: 1px solid #333;">
			<div style="display: flex; gap: 15px; align-items: center;">
				<label style="color: #888;">Select Entity:</label>
				<select
					data-model="selectedEntity"
					style="background: #1a1a1a; border: 1px solid #444; color: #fff; padding: 8px 12px; border-radius: 4px; min-width: 200px;">
					<option value="">-- All Active Streams --</option>
					for _, entityID := range entityIDs {
						<option value={ entityID }>{ entityID }</option>
					}
				</select>
				<button
					data-on-click="openVideoFullscreenByEntity($selectedEntity)"
					data-show="$selectedEntity != ''"
					style="background: #0a4; border: none; color: #fff; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
					Open Fullscreen
				</button>
			</div>
		</div>
		<div id="video-content" class="video-content" style="padding: 20px;">
			<!-- Single entity view (when entity selected) -->
			<div data-show="$selectedEntity != ''" style="display: flex; justify-content: center;">
				<div class="video-card-large" style="max-width: 1280px; width: 100%;">
					<div class="video-card-header" style="background: #1a1a1a; padding: 10px 15px; border-radius: 4px 4px 0 0; display: flex; justify-content: space-between; align-items: center;">
						<span style="color: #0ff; font-weight: bold;" data-text="'Entity: ' + $selectedEntity"></span>
						<span class="stream-status" style="color: #0f0; font-size: 12px;">WebRTC</span>
					</div>
					<div class="video-container-dynamic" style="background: #000; border-radius: 0 0 4px 4px; overflow: hidden; position: relative; aspect-ratio: 16/9;">
						<!-- WebRTC iframe - MediaMTX serves the player at /{entityID} with optional auth -->
						<iframe
							class="video-webrtc-dynamic"
							data-attr-src={ "$selectedEntity ? '" + mtxConfig.WebRTCURL + "/' + $selectedEntity + '" + mtxConfig.AuthQueryString() + "' : ''" }
							allow="autoplay; fullscreen"
							style="width: 100%; height: 100%; border: none;"></iframe>
						<div class="no-signal-overlay" style="display: none;">
							<span>No Video Signal</span>
						</div>
					</div>
				</div>
			</div>
			<!-- Grid view for all active streams -->
			<div data-show="$selectedEntity == ''">
				<div id="video-grid" class="video-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 20px;">
					<!-- Populated by SSE from /api/video/list -->
					<div class="empty-state" style="color: #888; padding: 40px; text-align: center; grid-column: 1 / -1;">
						<p>No active video streams detected.</p>
						<p style="font-size: 12px; margin-top: 10px;">Waiting for streams on MediaMTX server...</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Store MediaMTX config for JavaScript access -->
	<script data-mediamtx-url={ mtxConfig.WebRTCURL } data-mediamtx-auth={ mtxConfig.AuthQueryString() }>
		window.MEDIAMTX_WEBRTC_URL = document.currentScript.dataset.mediamtxUrl;
		window.MEDIAMTX_AUTH = document.currentScript.dataset.mediamtxAuth || '';
		function openVideoFullscreenByEntity(entityId) {
			if (!entityId) return;
			openVideoFullscreen(entityId);
		}
	</script>
}

// VideoCard renders a video card with WebRTC stream via MediaMTX
// Path structure: /{station_id}/{entity_id} (OrgID serves as station_id)
// Status can be: "live", "live (N viewers)", "offline"
templ VideoCard(entity shared.EntityState, mtxConfig components.MediaMTXConfig) {
	<div id={ "video-card-" + entity.EntityID } class={ "video-card", templ.KV("stream-offline", !isStreamLive(entity.Status)) } data-entity-id={ entity.EntityID } data-station-id={ entity.OrgID }>
		<div class="video-card-header">
			<span class="entity-name">
				if entity.Name != "" {
					{ entity.Name }
				} else {
					{ entity.EntityID }
				}
			</span>
			if entity.EntityType != "" {
				<span class="entity-type">{ entity.EntityType }</span>
			}
			<div class="video-card-stats">
				<span class={ "stream-status", templ.KV("online", isStreamLive(entity.Status)), templ.KV("offline", !isStreamLive(entity.Status)) }>
					if isStreamLive(entity.Status) {
						LIVE
					} else {
						OFFLINE
					}
				</span>
				<span class="viewer-count"></span>
			</div>
		</div>
		<div class="video-container" data-entity-id={ entity.EntityID } data-station-id={ entity.OrgID } style="aspect-ratio: 16/9;">
			<div class={ "no-signal-overlay", templ.KV("show", !isStreamLive(entity.Status)) }>
				<span>No Video Signal</span>
			</div>
			<!-- WebRTC iframe - MediaMTX serves the player at /{station_id}/{entity_id} with optional auth -->
			<iframe
				class="video-webrtc"
				src={ mtxConfig.BuildWebRTCURL(entity.OrgID, entity.EntityID) }
				allow="autoplay; fullscreen"
				style="width: 100%; height: 100%; border: none;"></iframe>
		</div>
		<div class="video-card-controls">
			<span class="status-label">{ entity.Status }</span>
			<button class="btn-fullscreen" data-entity-id={ entity.EntityID } data-station-id={ entity.OrgID } onclick="openVideoFullscreen(this.dataset.stationId, this.dataset.entityId)">
				Fullscreen
			</button>
		</div>
	</div>
}

// isStreamLive checks if the status indicates a live stream
func isStreamLive(status string) bool {
	return status == "live" || status == "active" || len(status) > 4 && status[:4] == "live"
}

// VideoPageStyles contains the styles and scripts for the video page
templ VideoPageStyles(mtxConfig components.MediaMTXConfig) {
	<script>
		// WebRTC stream management
		// MediaMTX handles the actual WebRTC connection - we just manage the iframes

		// Initialize WebRTC video cards on page load
		document.addEventListener('DOMContentLoaded', function() {
			document.querySelectorAll('.video-card').forEach(function(card) {
				const entityId = card.dataset.entityId;
				const iframe = card.querySelector('.video-webrtc');
				const overlay = card.querySelector('.no-signal-overlay');

				if (iframe) {
					// Hide overlay when iframe loads successfully
					iframe.onload = function() {
						if (overlay) overlay.style.display = 'none';
					};
					iframe.onerror = function() {
						if (overlay) overlay.style.display = 'flex';
					};
				}
			});
		});

		function openVideoFullscreen(stationId, entityId) {
			if (!entityId) {
				console.warn('[Video] No entityId provided for fullscreen');
				return;
			}

			// Get MediaMTX URL and auth from global or default
			const mediaMTXURL = window.MEDIAMTX_WEBRTC_URL || 'http://localhost:8889';
			const authQuery = window.MEDIAMTX_AUTH || '';

			// Build stream path: /{station_id}/{entity_id}
			const streamPath = stationId ? stationId + '/' + entityId : entityId;

			// Remove any existing modal first
			const existingModal = document.getElementById('video-fullscreen-modal');
			if (existingModal) existingModal.remove();

			// Create fullscreen modal with WebRTC iframe using safe DOM methods
			const modal = document.createElement('div');
			modal.id = 'video-fullscreen-modal';

			// Create header
			const header = document.createElement('div');
			header.className = 'fullscreen-header';

			const entityLabel = document.createElement('span');
			entityLabel.className = 'entity-label';
			entityLabel.textContent = stationId ? stationId + ' / ' + entityId : entityId;

			const streamType = document.createElement('span');
			streamType.className = 'stream-type';
			streamType.style.cssText = 'color: #0f0; font-size: 12px; margin-left: 10px;';
			streamType.textContent = 'WebRTC';

			const closeBtn = document.createElement('button');
			closeBtn.className = 'close-btn';
			closeBtn.textContent = 'Close (ESC)';
			closeBtn.onclick = closeVideoFullscreen;

			header.appendChild(entityLabel);
			header.appendChild(streamType);
			header.appendChild(closeBtn);

			// Create video container
			const videoContainer = document.createElement('div');
			videoContainer.className = 'fullscreen-video';

			const iframe = document.createElement('iframe');
			iframe.src = mediaMTXURL + '/' + streamPath + authQuery;
			iframe.allow = 'autoplay; fullscreen';
			iframe.style.cssText = 'width: 100%; height: 100%; border: none;';

			videoContainer.appendChild(iframe);
			modal.appendChild(header);
			modal.appendChild(videoContainer);
			document.body.appendChild(modal);

			// ESC key to close
			const escHandler = function(e) {
				if (e.key === 'Escape') {
					closeVideoFullscreen();
					document.removeEventListener('keydown', escHandler);
				}
			};
			document.addEventListener('keydown', escHandler);
		}

		function closeVideoFullscreen() {
			const modal = document.getElementById('video-fullscreen-modal');
			if (modal) modal.remove();
		}

	</script>
	<style>
		/* Video Card Styles */
		.video-card {
			background: #1a1a1a;
			border-radius: 4px;
			overflow: hidden;
			border: 1px solid #333;
			transition: border-color 0.3s ease;
		}

		.video-card.stream-offline {
			border-color: #622;
			opacity: 0.8;
		}

		.video-card-header {
			padding: 10px 15px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-bottom: 1px solid #333;
			background: #1a1a1a;
		}

		.video-card-header .entity-name {
			color: #0ff;
			font-weight: bold;
		}

		.video-card-header .entity-type {
			color: #ff0;
			font-size: 11px;
			text-transform: uppercase;
			background: rgba(255, 255, 0, 0.1);
			padding: 2px 6px;
			border-radius: 3px;
			margin-left: 8px;
		}

		.video-card-stats {
			display: flex;
			align-items: center;
			gap: 8px;
		}

		/* Stream Status Indicator */
		.stream-status {
			font-size: 10px;
			font-weight: 600;
			padding: 2px 8px;
			border-radius: 3px;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.stream-status.online {
			background: rgba(0, 255, 100, 0.2);
			color: #0f8;
			animation: pulse-live 2s infinite;
		}

		.stream-status.offline {
			background: rgba(255, 50, 50, 0.2);
			color: #f55;
		}

		@keyframes pulse-live {
			0%, 100% { opacity: 1; }
			50% { opacity: 0.7; }
		}

		/* Viewer Count */
		.viewer-count {
			font-size: 11px;
			color: #888;
		}

		.viewer-count:not(:empty) {
			padding: 2px 6px;
			background: rgba(255, 255, 255, 0.1);
			border-radius: 3px;
		}

		.video-card-stats .fps-counter {
			color: #888;
			font-size: 11px;
			font-family: monospace;
		}

		.video-card-stats .status-dot {
			width: 8px;
			height: 8px;
			background: #0f0;
			border-radius: 50%;
		}

		/* Video Container */
		.video-container {
			position: relative;
			background: #000;
		}

		.video-container .video-mjpeg {
			width: 100%;
			height: auto;
			display: block;
		}

		.video-container .no-signal-overlay {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(0, 0, 0, 0.85);
			display: none;
			align-items: center;
			justify-content: center;
			z-index: 10;
			color: #666;
			font-size: 14px;
		}

		.video-container .no-signal-overlay.show {
			display: flex;
		}

		/* Video Controls */
		.video-card-controls {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 8px 12px;
			background: #1a1a1a;
			border-top: 1px solid #333;
		}

		.video-card-controls .fps-counter {
			color: #0ff;
			font-size: 12px;
			font-family: monospace;
		}

		.video-card-controls .status-label {
			color: #0f0;
			font-size: 12px;
			text-transform: uppercase;
		}

		.status-dot.disconnected {
			background: #f00;
		}

		.btn-fullscreen {
			background: #0a4;
			border: none;
			color: #fff;
			padding: 6px 12px;
			border-radius: 4px;
			cursor: pointer;
			font-size: 12px;
		}

		.btn-fullscreen:hover {
			background: #0b5;
		}

		/* Fullscreen Modal */
		#video-fullscreen-modal {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: #000;
			z-index: 10000;
			display: flex;
			flex-direction: column;
		}

		.fullscreen-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 10px 20px;
			background: #111;
			border-bottom: 1px solid #333;
		}

		.fullscreen-header .entity-label {
			color: #0ff;
			font-weight: bold;
		}

		.fullscreen-header .close-btn {
			background: #a00;
			border: none;
			color: #fff;
			padding: 8px 16px;
			border-radius: 4px;
			cursor: pointer;
			transform: none !important;
		}

		.fullscreen-header .close-btn:hover {
			background: #c00;
			transform: none !important;
		}

		.fullscreen-video {
			flex: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #000;
		}

		.fullscreen-video img {
			max-width: 100%;
			max-height: calc(100vh - 60px);
			object-fit: contain;
		}
	</style>
}
