# Copy to ~/.config/constellation-overwatch/overwatch.env, replace every
# placeholder, and keep the file mode at 0600. The packaged installer does not
# copy or overwrite production secrets.
OVERWATCH_ENV=production
HOST=127.0.0.1
PORT=8090
NATS_HOST=127.0.0.1
# 4224 is the embedded listener. Tailnet TLS is published separately on 4223.
# Never use ao-ops-reserved port 4222.
NATS_PORT=4224
OVERWATCH_BASE_URL=https://REPLACE_WITH_HUB_DNS_NAME:8443
OVERWATCH_RPID=REPLACE_WITH_HUB_DNS_NAME
OVERWATCH_ALLOWED_ORIGINS=https://REPLACE_WITH_HUB_DNS_NAME:8443
OVERWATCH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
OVERWATCH_KEY_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OVERWATCH_ADMIN_EMAIL=REPLACE_WITH_OPERATOR_EMAIL
OVERWATCH_DATA_DIR=/ABSOLUTE/PERSISTENT/PATH/constellation-overwatch
OVERWATCH_BACKUP_DIR=/ABSOLUTE/BACKUP/PATH/constellation-overwatch
OVERWATCH_BOOTSTRAP_FILE=/ABSOLUTE/SECRET/PATH/constellation-overwatch-bootstrap.txt
