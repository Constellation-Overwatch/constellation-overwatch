# Constellation Overwatch development configuration.
# Copy to .env for local use. Production must use the explicit block below.

# --- Dev defaults (everything works out of the box) ---
OVERWATCH_ENV=development
# PORT=8080
# NATS_PORT=4222
# NATS_HOST=127.0.0.1        # Set to 0.0.0.0 for edge device NATS access
# OVERWATCH_DATA_DIR=./data
OVERWATCH_BASE_URL=http://localhost:8080
OVERWATCH_RPID=localhost
ALLOWED_ORIGINS=http://localhost:8080
# OVERWATCH_TRUSTED_PROXIES=  # Forwarding headers ignored when empty

# --- NATS TLS (for edge device connections) ---
# NATS_ENABLE_TLS=true
# NATS_TLS_CERT=/path/to/nats.crt
# NATS_TLS_KEY=/path/to/nats.key

# --- Video (optional, disabled by default) ---
# MEDIAMTX_API_URL=http://localhost:9997
# MEDIAMTX_WEBRTC_URL=http://localhost:8889

# --- Production (all values are required; examples are intentionally invalid) ---
# OVERWATCH_ENV=production
# HOST=127.0.0.1
# PORT=8080
# OVERWATCH_BASE_URL=https://hub.your-real-domain
# OVERWATCH_RPID=your-real-domain
# ALLOWED_ORIGINS=https://hub.your-real-domain
# OVERWATCH_TRUSTED_PROXIES=127.0.0.1/32
# OVERWATCH_KEY_HASH_SECRET=  # At least 32 random non-demo bytes
# OVERWATCH_DATA_DIR=/var/lib/constellation-overwatch
# OVERWATCH_BACKUP_DIR=/var/backups/constellation-overwatch
# OVERWATCH_ADMIN_EMAIL=operations@your-real-domain
# OVERWATCH_BOOTSTRAP_FILE=/run/constellation-overwatch/bootstrap.txt
