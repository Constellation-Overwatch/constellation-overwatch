# Constellation Overwatch development profile.
# Copy to .env for local-only development. It is intentionally rejected as a
# production profile and must not be exposed to a network.
OVERWATCH_ENV=development
HOST=127.0.0.1
PORT=8080
NATS_HOST=127.0.0.1
NATS_PORT=4222
OVERWATCH_DATA_DIR=./data
OVERWATCH_BASE_URL=http://localhost:8080
OVERWATCH_RPID=localhost
OVERWATCH_ALLOWED_ORIGINS=http://localhost:8080

# --- NATS TLS (for edge device connections) ---
# NATS_ENABLE_TLS=true
# NATS_TLS_CERT=/path/to/nats.crt
# NATS_TLS_KEY=/path/to/nats.key

# --- Video (optional, disabled by default) ---
# MEDIAMTX_API_URL=http://localhost:9997
# MEDIAMTX_WEBRTC_URL=http://localhost:8889

# Production is fail-closed. See docs/production-deployment.md for every
# required value, secure bootstrap delivery, and proxy configuration.
